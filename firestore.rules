rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ----------------------------------------------------------------------
    // DEFAULT DENY: Protect all admin collections (messages, team, etc.)
    // Only the server-side Firebase Admin SDK can bypass this.
    // ----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
    function isSignedIn() {
      return request.auth != null;
    }

    function isFollowing(authorId) {
      return exists(
        /databases/$(database)/documents/users/$(request.auth.uid)/following/$(authorId)
      );
    }

    function canReadPost(post) {
      // `post` is expected to be a document data object with fields:
      // authorId, visibility
      return isSignedIn() && (
        post.visibility == 'public' ||
        post.authorId == request.auth.uid ||
        (post.visibility == 'followers' && isFollowing(post.authorId))
      );
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /following/{targetUserId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /followers/{sourceUserId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        // This edge is owned by the "sourceUserId" (the follower).
        allow create, delete: if isSignedIn() && request.auth.uid == sourceUserId;
      }
    }

    match /posts/{postId} {
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      allow read: if isSignedIn() && canReadPost(resource.data);

      match /comments/{commentId} {
        allow read: if isSignedIn() && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);

        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);

        allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }

      match /likes/{userId} {
        allow read: if isSignedIn() && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);

        allow create: if isSignedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);

        allow delete: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /feeds/{viewerId}/items/{feedItemId} {
      allow read: if isSignedIn() && request.auth.uid == viewerId;
      // Client writes are disabled; this path is intended for server/fanout.
      allow write: if false;
    }
  }
}

